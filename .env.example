# ==========================================
# Songothon Environment Configuration
# ==========================================

APP_ENV=development
PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_secure_pass
DB_NAME=songothon_db
DB_SSLMODE=disable

# Authentication
JWT_SECRET=super-secret-songothon-jwt-key-change-in-production-2026
JWT_EXPIRY_HOURS=72

# Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY=
FCM_PROJECT_ID=songothon-dev

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
