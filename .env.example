# ==========================================
# Songothon Docker Compose Environment
# ==========================================
# Used by docker-compose.yml to configure the Postgres container.
# Application settings (JWT, FCM, DB connection for the API) live in
# backend/config.*.json (CONFIG_FILE_PATH) or Consul (CONSUL_URL + CONSUL_PATH).

DB_USER=postgres
DB_PASSWORD=postgres_secure_pass
DB_NAME=songothon_db
DB_PORT=5432
