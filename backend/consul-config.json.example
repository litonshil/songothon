{
  "app": {
    "name": "songothon",
    "port": 8080,
    "env": "production",
    "log_level": "info",
    "jwt_secret": "CHANGE_ME_JWT_SECRET",
    "jwt_expiry_hours": 72
  },
  "db": {
    "db": {
      "host": "songothon_postgres",
      "port": 5432,
      "name": "songothon_db",
      "username": "postgres",
      "password": "CHANGE_ME_DB_PASSWORD",
      "ssl_mode": "disable",
      "max_life_time": 3600,
      "max_idle_conn": 5,
      "max_open_conn": 25
    }
  },
  "fcm": {
    "fcm": {
      "server_key": "CHANGE_ME_FCM_SERVER_KEY",
      "project_id": "songothon-dev"
    }
  }
}
